[Unit]
Description=sig.golf site and webhook
After=network.target

[Service]
User=sig-web
Group=sig-state
UMask=0007
WorkingDirectory=/srv/sig/repo/service
EnvironmentFile=/etc/sig/public.env
EnvironmentFile=/etc/sig/secrets.env
Environment=SIG_REPO_ROOT=/srv/sig/repo
Environment=SIG_ENV=production
Environment=SIG_ROLE=web
ExecStart=/srv/sig/repo/service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/sig/data
PrivateTmp=true
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestartSec=5
MemoryMax=1G

[Install]
WantedBy=multi-user.target
