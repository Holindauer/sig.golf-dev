beta.sig.golf {
    encode zstd gzip
    root * /srv/sig-golf/public
    redir / /site/ 302
    rewrite /llms.txt /site/llms.txt
    file_server
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' https://raw.githubusercontent.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
    }
}
