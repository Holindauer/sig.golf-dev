[Unit]
Description=sig.golf beta submission verifier and publisher
After=network-online.target
Wants=network-online.target

[Service]
User=sigbot
Group=sigwork
UMask=0007
WorkingDirectory=/srv/sig-golf/repo
Environment=PATH=/srv/sig-golf/verify-home/.elan/bin:/usr/local/bin:/usr/bin:/bin
Environment=SIG_VERIFIER_USER=sigverify
Environment=SIG_SHARED_VERIFY_LOCK=/srv/sig-golf/verify.lock
ExecStart=/usr/bin/python3 /srv/sig-golf/repo/service/bot.py --token-file /etc/sig-golf/github-token --work-root /srv/sig-golf/work --records-file /srv/sig-golf/public/site/records.json --state-file /srv/sig-golf/public/site/state.json
Restart=always
RestartSec=10
MemoryMax=2G

[Install]
WantedBy=multi-user.target
