+/-- Recheck every declaration in the untrusted solution tree against its
+trusted imports. This detects environment hacking while avoiding a fresh
+replay of large trusted dependencies whose declarations were originally
+checked with higher, declaration-local recursion limits. -/
+def safeLeanCheck (modulePrefix : Lean.Name) : M Unit := do
+  IO.println s!"Kernel-checking untrusted modules under {modulePrefix}"
+  let leanPrefix ← getLeanPrefix
+  let projectDir ← getProjectDir
+  let dotLakeDir := projectDir / ".lake"
+  runSandBoxed {
+    cmd := (leanPrefix / "bin" / "leanchecker").toString
+    args := #[modulePrefix.toString]
+    envPass := #["PATH", "HOME", "LEAN_PATH", "LEAN_ABORT_ON_PANIC"]
+    envOverride := #[("LEAN_ABORT_ON_PANIC", some "1")]
+    readablePaths := #[projectDir, dotLakeDir]
+    writablePaths := #[]
+    executablePaths := #[leanPrefix]
+  }
+
